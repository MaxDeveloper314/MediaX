<Window x:Class="MediaX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaX"
        mc:Ignorable="d"
        Title="MediaX - Social Viewer" Height="720" Width="1100"
        Background="#FFF3F4F6">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Feed -->
        <GroupBox Header="Feed" Grid.Column="0" Margin="4">
            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="4" Text=""/>
                <ListBox x:Name="FeedList" Margin="4" SelectionChanged="FeedList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6" Margin="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Owner}" FontSize="11" Foreground="Gray"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Dislikes:" FontSize="11"/>
                                        <TextBlock Text="{Binding Dislikes}" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- Center: Player -->
        <GroupBox Header="Player" Grid.Column="1" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>

                <MediaElement x:Name="Player" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" />

                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="8">
                    <TextBlock x:Name="NowPlayingText" FontWeight="Bold" Text="No video loaded" Margin="2"/>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Button x:Name="PlayBtn" Click="PlayBtn_Click" Width="80" Margin="4">Play</Button>
                        <Button x:Name="PauseBtn" Click="PauseBtn_Click" Width="80" Margin="4">Pause</Button>
                        <Button x:Name="StopBtn" Click="StopBtn_Click" Width="80" Margin="4">Stop</Button>

                        <Separator Width="20"/>

                        <Button x:Name="LikeBtn" Click="LikeBtn_Click" Width="80" Margin="4">Watch</Button>
                        <Button x:Name="DislikeBtn" Click="DislikeBtn_Click" Width="80" Margin="4">Dislike</Button>

                        <Separator Width="20"/>

                        <Button x:Name="MakeShortBtn" Click="MakeShortBtn_Click" Width="120" Margin="4">Make 15s Short</Button>
                    </StackPanel>

                    <ProgressBar x:Name="PositionBar" Height="14" Margin="2" Minimum="0" Maximum="1"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Right: Pupils / Chat -->
        <GroupBox Header="Pupils" Grid.Column="2" Margin="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                    <TextBox x:Name="NewPupilBox" Width="160" Margin="0,0,4,0" Text=""/>
                    <Button Content="Add" Click="AddPupil_Click" Width="80"/>
                </StackPanel>

                <ListBox x:Name="PupilsList" Margin="4" SelectionChanged="PupilsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                <TextBlock Text=" ►" Foreground="Gray" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
